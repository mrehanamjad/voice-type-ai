{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeVoice",
  "version": "0.1.0",
  "identifier": "com.rehan.typevoice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TypeVoice",
        "width": 840,
        "height": 640,
        "transparent": false,
        "scrollBarStyle": "default",
        "preventOverflow": false,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "Overlay",
        "url": "overlay.html",
        "width": 120,
        "height": 48,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "x": 623,
        "y": 10
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
